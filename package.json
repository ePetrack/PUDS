{
  "name": "puds",
  "version": "0.1.0",
  "description": "Personal utility (energy + water) management on vanilla DuckDB.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "seed": "tsx src/cli/seed.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.1",
    "@fastify/formbody": "^8.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
