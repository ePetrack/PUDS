# Application
ENV=development
DEBUG=true

# Database - SQLite (default, no installation required)
DATABASE_URL=sqlite+aiosqlite:///./puds.db

# For PostgreSQL/TimescaleDB (requires PostgreSQL installation):
# DATABASE_URL=postgresql+asyncpg://puds_user:puds_password_dev@localhost:5432/puds

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ISO 50001 Settings
ENERGY_BASELINE_PERIOD_MONTHS=12
ENPI_CALCULATION_FREQUENCY=monthly
